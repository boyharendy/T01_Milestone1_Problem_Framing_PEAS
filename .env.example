# Salin file ini menjadi .env jika Anda memiliki Google Gemini API Key:
# cp .env.example .env (atau copy manual di file explorer)
#
# Dapatkan API Key gratis di: https://aistudio.google.com/apikey
#
# CATATAN: Jika GEMINI_API_KEY dikosongkan atau file .env tidak ada,
# sistem otomatis beralih ke Mode Offline / Local Model / Rule-Based Heuristic
# sehingga program tetap berjalan lancar tanpa error!

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
